{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "facts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verify_next": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "statement",
          "source",
          "locator"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "facts",
    "inferences",
    "hypotheses",
    "unknowns",
    "verify_next",
    "evidence"
  ],
  "additionalProperties": false
}
