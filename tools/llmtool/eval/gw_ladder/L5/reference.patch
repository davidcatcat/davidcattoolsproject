+class IsSlugTests(unittest.TestCase):
+    def test_valid_values(self):
+        self.assertTrue(is_slug("alpha"))
+        self.assertTrue(is_slug("alpha-2"))
+        self.assertTrue(is_slug("x9"))
+
+    def test_empty_and_edge_hyphens(self):
+        self.assertFalse(is_slug(""))
+        self.assertFalse(is_slug("-alpha"))
+        self.assertFalse(is_slug("alpha-"))
+
+    def test_repeated_hyphens(self):
+        self.assertFalse(is_slug("alpha--beta"))
+
+    def test_invalid_characters_and_types(self):
+        self.assertFalse(is_slug("Alpha"))
+        self.assertFalse(is_slug("two words"))
+        self.assertFalse(is_slug("under_score"))
+        self.assertFalse(is_slug(None))
