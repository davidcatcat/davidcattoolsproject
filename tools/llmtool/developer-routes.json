{
  "schema_version": 1,
  "routes": {
    "agy": {
      "executable": "agy",
      "default_model": "gemini-3.8-flash-medium",
      "allowed_models": ["gemini-3.8-flash-medium"],
      "default_effort": "medium",
      "denied_dirs": [".gemini"],
      "state_dirs": {"policy": "private-temp-only"}
    },
    "claude": {
      "executable": "claude",
      "default_model": "claude-opus-5-5",
      "allowed_models": ["claude-opus-5-5"],
      "default_effort": "high",
      "denied_dirs": [".claude"],
      "state_dirs": {"policy": "private-temp-only"}
    },
    "gw-agent": {
      "package_path": "~/.local/lib/api-agent-gateway",
      "default_model": "gw",
      "allowed_models": ["gw"],
      "default_effort": "low",
      "profile_name": "llmtool-direct",
      "profile": {
        "adapter": "openai-chat-tools",
        "auth_env": "GW_AGENT_API_KEY",
        "model": "gw",
        "context_cap_tokens": 32768,
        "max_output_tokens": 16384,
        "allowed_data_classes": ["synthetic", "public_repo"],
        "data_class_map": {"SYNTHETIC": "synthetic", "PUBLIC_REPO": "public_repo"}
      },
      "authorization_ref": "https://github.com/davidcatcat/davidcattoolsproject/issues/120#issuecomment-6760670167",
      "allowed_data_classes": ["synthetic", "public_repo"]
    },
    "opencode": {
      "executable": "opencode",
      "default_model": "opencode/deepseek-v4.1-flash-free",
      "allowed_models": ["opencode/deepseek-v4.1-flash-free"],
      "default_effort": "high"
    }
  },
  "roles": {
    "codex-reviewer": {"allowed_models": ["gpt-6.1-sol"]},
    "claude-reviewer": {"allowed_models": ["claude-sonnet-5-5"]},
    "codex-debug": {"allowed_models": ["gpt-6.1-sol"]},
    "claude-debug": {"allowed_models": ["claude-opus-5-5"]}
  }
}
