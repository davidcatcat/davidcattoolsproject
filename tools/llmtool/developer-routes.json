{
  "schema_version": 1,
  "routes": {
    "agy": {
      "executable": "agy",
      "default_model": "gemini-3.8-flash-medium",
      "default_effort": "medium",
      "denied_dirs": [".gemini"],
      "state_dirs": {"policy": "private-temp-only"},
      "default_timeout": 1800,
      "max_timeout": 3600,
      "max_diff_bytes": 262144,
      "max_prompt_bytes": 524288
    },
    "claude": {
      "executable": "claude",
      "default_model": "claude-opus-5-5",
      "default_effort": "high",
      "denied_dirs": [".claude"],
      "state_dirs": {"policy": "private-temp-only"},
      "default_timeout": 1800,
      "max_timeout": 3600,
      "max_diff_bytes": 262144,
      "max_prompt_bytes": 65536
    },
    "gw-agent": {
      "package_path": "~/.local/lib/api-agent-gateway",
      "default_model": "gw",
      "allowed_models": ["gw"],
      "default_effort": "low",
      "profile_name": "llmtool-direct",
      "profile": {
        "adapter": "openai-chat-tools",
        "auth_env": "GW_AGENT_API_KEY",
        "model": "gw",
        "context_cap_tokens": 32768,
        "max_output_tokens": 16384,
        "timeout_seconds": 1800,
        "allowed_data_classes": ["synthetic", "public_repo"],
        "data_class_map": {"SYNTHETIC": "synthetic", "PUBLIC_REPO": "public_repo"}
      },
      "authorization_ref": "https://github.com/davidcatcat/davidcattoolsproject/issues/120#issuecomment-6760670167",
      "allowed_data_classes": ["synthetic", "public_repo"],
      "budgets": {
        "max_turns": 512,
        "max_input_tokens": 262144,
        "max_output_tokens": 65536,
        "max_wall_seconds": 1800,
        "max_tool_result_bytes": 262144,
        "max_sent_bytes": 16777216
      },
      "default_timeout": 1800,
      "max_timeout": 3600
    },
    "opencode": {
      "executable": "opencode",
      "default_model": "opencode/deepseek-v4.1-flash-free",
      "default_effort": "high",
      "default_timeout": 1800,
      "max_timeout": 3600,
      "max_diff_bytes": 262144,
      "max_prompt_bytes": 65536,
      "max_source_file_bytes": 1048576,
      "max_source_total_bytes": 2097152
    }
  },
  "roles": {
    "codex-reviewer": {"default_model": "gpt-6.1-sol"},
    "claude-reviewer": {"default_model": "claude-sonnet-5-5"},
    "codex-debug": {"default_model": "gpt-6.1-sol"},
    "claude-debug": {"default_model": "claude-opus-5-5"}
  }
}
