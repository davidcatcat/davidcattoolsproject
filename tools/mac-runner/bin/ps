#!/usr/bin/env python3
"""The subset of ps(1) the llmtool tests use, for the sandboxed Mac CI job.

A sandboxed process cannot run the setuid /bin/ps, and macOS kills a copy of
it, so the Mac CI puts this first on PATH (Issue #99). It reads the same
kernel table as ps (sysctl kern.proc) and prints the same columns:

    ps -A -o pid=,pgid=,stat=
    ps -o pid=,ppid=,pgid=,stat= -p PID[,PID...]

STAT is Z (zombie), T (stopped) or S (any other), without ps's +/s flags.
Anything else exits 2.
"""
import ctypes
import struct
import sys

CTL_KERN, KERN_PROC, KERN_PROC_ALL, KERN_PROC_PID = 1, 14, 0, 1
# struct kinfo_proc (x86_64/arm64 macOS): kp_proc.p_stat, kp_proc.p_pid,
# kp_eproc.e_ppid, kp_eproc.e_pgid. Checked against /bin/ps by selftest.sh.
SIZE, STAT, PID, PPID, PGID = 648, 36, 40, 560, 564
# p_stat is coarse (a sleeping process reads SRUN), so only stopped and
# zombie are told apart; the tests only ask whether a process is a zombie.
STATES = {4: 'T', 5: 'Z'}
COLUMNS = {'pid': PID, 'ppid': PPID, 'pgid': PGID}

libc = ctypes.CDLL(None, use_errno=True)
libc.sysctl.argtypes = (ctypes.POINTER(ctypes.c_int), ctypes.c_uint, ctypes.c_void_p,
                        ctypes.POINTER(ctypes.c_size_t), ctypes.c_void_p, ctypes.c_size_t)


def table(*mib):
    name = (ctypes.c_int * len(mib))(*mib)
    for _ in range(8):
        size = ctypes.c_size_t(0)
        if libc.sysctl(name, len(mib), None, ctypes.byref(size), None, 0) != 0:
            break
        buffer = ctypes.create_string_buffer(size.value + 16 * SIZE)
        size = ctypes.c_size_t(len(buffer))
        if libc.sysctl(name, len(mib), buffer, ctypes.byref(size), None, 0) == 0:
            return buffer.raw[:size.value]
        if ctypes.get_errno() != 12:  # ENOMEM: the table grew, retry
            break
    raise OSError(ctypes.get_errno(), 'sysctl kern.proc failed')


def rows(data):
    for offset in range(0, len(data) - SIZE + 1, SIZE):
        entry = data[offset:offset + SIZE]
        values = {name: struct.unpack_from('i', entry, at)[0] for name, at in COLUMNS.items()}
        values['stat'] = STATES.get(entry[STAT], 'S')
        yield values


def main(argv):
    if argv[:1] == ['-A'] and argv[1:2] == ['-o'] and len(argv) == 3:
        spec, pids = argv[2], None
    elif argv[:1] == ['-o'] and argv[2:3] == ['-p'] and len(argv) == 4:
        spec = argv[1]
        try:
            pids = [int(pid) for pid in argv[3].split(',')]
        except ValueError:
            return 2
    else:
        return 2
    columns = [column[:-1] for column in spec.split(',')]
    if not columns or any(not spec_part.endswith('=') for spec_part in spec.split(',')) or \
            any(column not in (*COLUMNS, 'stat') for column in columns):
        return 2
    found = []
    try:
        collect(found, pids)
    except OSError as error:
        print('ps: %s' % error, file=sys.stderr)
        return 1
    for row in found:
        print(' '.join(str(row[column]) for column in columns))
    return 0 if found or pids is None else 1


def collect(found, pids):
    if pids is None:
        found.extend(rows(table(CTL_KERN, KERN_PROC, KERN_PROC_ALL, 0)))
    else:
        for pid in pids:
            found.extend(row for row in rows(table(CTL_KERN, KERN_PROC, KERN_PROC_PID, pid))
                         if row['pid'] == pid)


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
