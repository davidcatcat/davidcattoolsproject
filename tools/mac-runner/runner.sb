(version 1)
; Sandbox for the self-hosted Actions runner on the Owner's Mac (Issue #99).
; The runner runs as the Owner's own macOS account, so without this every CI
; step could read SSH/AWS/VPN files, the keychain and other Agents' worktrees.
; install.sh starts the runner service under this profile; every job step is
; a child of the runner and inherits it, whatever the workflow file says.
;
; Parameters (sandbox-exec -D): REAL_HOME, RUNNER_ROOT. profile.sh appends
; the runner folder's ancestors as single readable directories.
; Not covered here, see README.md: network reach (incl. VPN) and the runner's
; own registration credential.
(allow default)

; Read: none of the account's data; the runner directory is the only part of
; the home the job can see. Temp folders are shared with the Agents.
(deny file-read* file-write*
  (subpath "/Users")
  (subpath "/private/tmp")
  (subpath "/private/var/tmp")
  (subpath "/private/var/folders")
  (subpath "/Volumes"))
(allow file-read* (subpath (param "RUNNER_ROOT")))
; llmtool and its tests make their own folders directly in /tmp and /var/tmp
; (fixed paths, not TMPDIR). Only names Python's tempfile or llmtool create
; are reachable; the Agents' folders there (e.g. claude-501) are not.
(define temp-own #"^/private/(var/)?tmp/(tmp|llmtool-)[^/]+(/.*)?$")
(allow file-read* (regex temp-own))
; /usr/bin/git and the other Xcode shims read the account-wide xcrun cache,
; including with a scrubbed environment. Read only: the Owner's own git uses
; it, so writing it would run a job's code outside the sandbox (#335 H1).
; install.sh creates it before the runner starts.
(allow file-read* (regex #"^/private/var/folders/[^/]+/[^/]+/T/xcrun_db$"))
; llmtool's path checks open each directory on the way (openat walk), so the
; two temp roots can be opened and listed; their other entries stay closed.
(allow file-read-data (literal "/private/tmp") (literal "/private/var/tmp"))
; stat() only, for path resolution (realpath of the work folder); listing a
; folder or reading a file still needs file-read-data.
(allow file-read-metadata)

; Write: only the runner's work, log, home and temp folders, so a job cannot
; change the runner, this profile, Homebrew tools or anything run later.
(deny file-write* (subpath "/"))
(allow file-write*
  (regex temp-own)
  (subpath (string-append (param "RUNNER_ROOT") "/_work"))
  (subpath (string-append (param "RUNNER_ROOT") "/_diag"))
  (subpath (string-append (param "RUNNER_ROOT") "/_home"))
  (subpath (string-append (param "RUNNER_ROOT") "/_tmp"))
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/dtracehelper")
  (literal "/dev/tty")
  (regex #"^/dev/fd/"))
; The account's terminals (/dev/ttys*) would let a job read what the Owner
; types; new pseudo-terminals cannot be told apart from them by path.
(deny file-read* file-write* (regex #"^/dev/(ttys|pty|ptmx)"))

; Sockets of the account's own services (ssh-agent, Docker, Agent servers).
(deny network-outbound
  (remote unix-socket (subpath "/private/var/run"))
  (remote unix-socket (subpath "/Users"))
  (remote unix-socket (subpath "/private/tmp"))
  (remote unix-socket (subpath "/private/var/folders")))
; Name resolution goes through this socket.
(allow network-outbound (remote unix-socket (path-literal "/private/var/run/mDNSResponder")))

; Keychain, clipboard, and ways to start a process outside the sandbox:
; LaunchServices (open), Apple Events (Terminal/Finder scripting), launchd.
(deny mach-lookup
  (global-name "com.apple.SecurityServer")
  (global-name-prefix "com.apple.pasteboard")
  (global-name-regex #"^com\.apple\.(coreservices|lsd|appleevents|ae)"))
(deny lsopen)
(deny appleevent-send)
(deny process-exec (literal "/bin/launchctl") (literal "/usr/bin/osascript")
  (literal "/usr/bin/open"))

; Other processes of the account (Agents, terminals): no inspection, no
; signals. Processes inside this sandbox (the runner, its jobs and their
; children, e.g. a test killing its own process group) are allowed.
(deny process-info* (target others))
; Another process's command line and environment (Agents' tokens) come from
; this sysctl, which process-info does not cover. pid/pgid/state stay
; readable, as for any process of any account (tools/mac-runner/bin/ps).
(deny sysctl-read (sysctl-name-prefix "kern.procargs"))
(allow process-info* (target same-sandbox))
(deny signal (target others))
(allow signal (target same-sandbox))
